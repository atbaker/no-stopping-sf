{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "no-stopping-sf",
  "account_id": "9de7a2cc84d49d6d89f6c22f3326f1e7",
  "compatibility_date": "2026-10-07",
  "workers_dev": true,
  "assets": {
    "directory": "./site/dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "nostoppingsf.io", "custom_domain": true }
  ]
}
